{
  "name": "particle-photo",
  "productName": "Particle Photo",
  "version": "0.1.0",
  "type": "module",
  "description": "Turn a photo into an interactive 3D particle scene.",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:stability": "playwright test --config playwright.stability.config.ts",
    "test:acceptance:images": "node scripts/test-acceptance-images.mts",
    "audit:ui": "node scripts/audit-english-ui.mts",
    "audit:security": "node scripts/audit-security.mts",
    "verify:models": "node scripts/verify-model-assets.mts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "author": "Particle Photo contributors",
  "license": "UNLICENSED",
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
